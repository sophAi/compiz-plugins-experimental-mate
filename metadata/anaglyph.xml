<?xml version='1.0' encoding='utf-8'?>
<compiz>
	<plugin useBcop="true" name="anaglyph">
		<short>Anaglyph</short>
		<short xml:lang="en_GB">Anaglyph</short>
		<short xml:lang="es">Anáglifo</short>
		<long>Anaglyph window and Desktop</long>
		<long xml:lang="en_GB">Anaglyph window and Desktop</long>
		<long xml:lang="es">Escritorio y ventana en Anaglifo</long>
		<category>Effects</category>
		<deps>
			<relation type="after">
				<plugin>ring</plugin>
				<plugin>shift</plugin>
				<plugin>scale</plugin>
			</relation>
		</deps>
		<options>
			<option type="key" name="window_toggle_key">
				<short>Initiate Window</short>
				<short xml:lang="ca">Inicia la finestra</short>
				<short xml:lang="en_GB">Initiate Window</short>
				<short xml:lang="es">Iniciar en la ventana</short>
				<long>Start anaglyph window</long>
				<long xml:lang="en_GB">Start anaglyph window</long>
				<long xml:lang="es">Comience la ventana en anaglifo</long>
			</option>
			<option type="key" name="screen_toggle_key">
				<short>Initiate Screen</short>
				<short xml:lang="ca">Inicia la pantalla</short>
				<short xml:lang="en_GB">Initiate Screen</short>
				<short xml:lang="es">Iniciar en Escritorio</short>
				<long>Start anaglyph screen</long>
				<long xml:lang="en_GB">Start anaglyph screen</long>
				<long xml:lang="es">Iniciar en pantalla anaglifo</long>
			</option>
			<option type="button" name="window_toggle_button">
				<short>Initiate Window Button</short>
				<short xml:lang="ca">Inicia el botó de la finestra</short>
				<short xml:lang="en_GB">Initiate Window Button</short>
				<long>Start anaglyph active window</long>
				<long xml:lang="en_GB">Start anaglyph active window</long>
				<long xml:lang="es">Iniciar anaglifo en la ventana activa</long>
			</option>
			<option type="button" name="screen_toggle_button">
				<short>Initiate Screen Button</short>
				<short xml:lang="ca">Inicia el botó de la pantalla</short>
				<short xml:lang="en_GB">Initiate Screen Button</short>
				<long>Start anaglyph screen</long>
				<long xml:lang="en_GB">Start anaglyph screen</long>
				<long xml:lang="es">Iniciar en pantalla anaglifo</long>
			</option>
			<option type="match" name="anaglyph_match">
				<short>Anaglyph Windows</short>
				<short xml:lang="en_GB">Anaglyph Windows</short>
				<short xml:lang="es">Ventanas Anaglifo</short>
				<long>Windows to be anaglyph by default</long>
				<long xml:lang="en_GB">Windows to be anaglyph by default</long>
				<long xml:lang="es">Ventanas para ser anaglifo por defecto</long>
				<default>any</default>
			</option>
			<option type="match" name="exclude_match">
				<short>Exclude Windows</short>
				<short xml:lang="de">Ausgeschlossene Fenster</short>
				<short xml:lang="el">Αποκλεισμός Παραθύρων</short>
				<short xml:lang="en_GB">Exclude Windows</short>
				<short xml:lang="es">Ventanas excluídas</short>
				<short xml:lang="eu">Kontuan ez hartzeko leihoak</short>
				<short xml:lang="fi">Ei käytössä näissä ikkunoissa</short>
				<short xml:lang="fr">Exclure les fenêtres</short>
				<short xml:lang="gl">Excluír Fiestras</short>
				<short xml:lang="gu">વિન્ડો નહિં સમાવો</short>
				<short xml:lang="he">התעלם מחלונות</short>
				<short xml:lang="hi">विंडोज़ निकालें</short>
