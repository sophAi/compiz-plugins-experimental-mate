<?xml version="1.0"?>
<compiz>
    <plugin name="stars" useBcop="true">
    <_short>Stars</_short>
    <_long>Stars elements plugin</_long>
    <category>Extras</category>
	<deps>
	    <requirement>
		<plugin>elements</plugin>
	    </requirement>
	    <relation type="after">
		<plugin>elements</plugin>
	    </relation>
	</deps>
	<options>
	<group>
	    <_short>Stars</_short>
	    <option name="autostart" type="bool">
		    <_short>Autostart</_short>
		    <_long>Automatically start this element when the plugin is loaded</_long>
		    <default>false</default>
	    </option>
	    <option name="toggle_star" type="key">
		    <_short>Toggle all stars elements</_short>
		    <_long>Toggle all stars elements defined in the elements
			   list</_long>
		    <default>&lt;Super&gt;&lt;Alt&gt;t</default>
	    </option>
	    <option name="star_offset_x" type="int">
		    <_short>Star X Offset</_short>
		    <_long>The X point on the screen where stars should start</_long>
		    <default>0</default>
		    <min>-1000</min>
		    <max>1000</max>
	    </option>
	    <option name="star_offset_y" type="int">
		    <_short>Star Y Offset</_short>
		    <_long>The Y point on the screen where stars should start</_long>
		    <default>0</default>
		    <min>-1000</min>
		    <max>1000</max>
	    </option>
	</group>
	</options>

      <extension base_plugin="elements" screen="true">
	<base_option>element_type</base_option>
	<restriction>
	  <value>stars</value>
	  <_name>Stars</_name>
	</restriction>
      </extension>

    </plugin>
</compiz>
