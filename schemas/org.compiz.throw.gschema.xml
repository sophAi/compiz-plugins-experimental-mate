      <default>10.0</default>
      <summary>X Velocity Multiplier</summary>
      <description>X Velocity Multipler (1.0 - 100.0)</description>
    </key>
    <key type="d" name="velocity-y">
      <default>10.0</default>
      <summary>Y Velocity Multiplier</summary>
      <description>Y Velocity Multipler (1.0 - 100.0)</description>
    </key>
